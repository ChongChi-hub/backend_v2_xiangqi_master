# ============================================================
# Backend Environment Variables Template
# Copy file này thành .env và điền các giá trị thực
# ============================================================

# --- Database ---
# MySQL connection string
DATABASE_URL="mysql://username:password@localhost:3306/xiangqi_db"

# --- Authentication ---
# JWT secret key - THAY ĐỔI NGAY trong production!
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# --- Server ---
HOST=0.0.0.0
PORT=3579

# --- Pikafish AI Engine (tùy chọn) ---
# Mặc định sẽ tự detect OS và dùng binary phù hợp trong src/services/engines/
# Chỉ cần set nếu muốn dùng binary ở vị trí khác
# PIKAFISH_PATH=/custom/path/to/pikafish
# NNUE_PATH=/custom/path/to/pikafish.nnue
